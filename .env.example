# Copy to .env and edit. All variables are prefixed PTEST_.

# --- Platform ---
PTEST_ENVIRONMENT=development
# Use PostgreSQL in production. Keep this SEPARATE from any game/production DB.
# PTEST_DATABASE_URL=postgresql+psycopg://ptest:ptest@db:5432/ptest
PTEST_DATABASE_URL=sqlite:///./ptest.db

# CHANGE THESE. secret_key signs internal state; bootstrap admin is first-run only.
PTEST_SECRET_KEY=please-generate-a-long-random-value
PTEST_BOOTSTRAP_ADMIN_USERNAME=admin
PTEST_BOOTSTRAP_ADMIN_PASSWORD=please-change-me

# --- Safety controls ---
PTEST_EMERGENCY_STOP=false
PTEST_REQUIRE_AUTHORIZATION_RECORD=true
PTEST_MAX_SCAN_CONCURRENCY=32
PTEST_PORT_SCAN_RATE_PER_SEC=50
PTEST_HTTP_RATE_PER_SEC=5
PTEST_CONNECT_TIMEOUT_SEC=3
PTEST_MAX_PORTS_PER_HOST=1024
PTEST_TOKEN_TTL_MINUTES=720
PTEST_AUDIT_LOG_FILE=./audit.log
